    "turret-dps": "node tools/turret-dps.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
