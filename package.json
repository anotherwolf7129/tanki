{
  "name": "tank-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser 3D tank arena shooter — one human player against a field of AI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate-maps": "node tools/validate-maps.mjs",
    "raid-smoke": "node tools/raid-smoke.mjs",
